# ForgeX environment. Copy to .env.local and fill in only what you need.
# Every value is optional for local development.

# Public base URL, used for links in notifications and Stripe redirects.
APP_URL=http://localhost:3000

# Database. Leave empty to use the embedded local Postgres (PGlite) stored in ./.data/pglite.
# Production: a managed Postgres URL, e.g. postgres://user:pass@host:5432/forgex
DATABASE_URL=

# AI scoping (optional). Without a key ForgeX uses its built-in template scoper.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Gemini research benchmark (optional). Use only the dedicated ForgeX project's key, restricted to the
# Gemini API. You add it here yourself; it is never pasted into chat, committed or logged.
GEMINI_API_KEY=

# Stripe (optional). Use TEST-mode keys only until launch is approved.
# Without keys, payments are recorded by an operator (bank transfer / invoice).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local development only: shows a clearly labeled "simulate test payment" button.
# Test payments are excluded from revenue metrics. Never enable in production.
ALLOW_TEST_PAYMENTS=true

# Demo data (npm run db:seed). Every demo account uses this password. Leave it empty and the seed script generates a
# random one and prints it once. Never reuse it for a real account: an owner can't be designated with it.
SEED_PASSWORD=

# Optional: an extra database folder the acceptance tooling must never treat as a test copy (your real data folder,
# if it isn't this project's .data).
KELQOR_REAL_DATA_DIR=
